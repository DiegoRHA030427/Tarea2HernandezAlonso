<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco_lineas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:textColor="@color/negro_arbitro"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="@string/titulo_ajustes_juego" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="@color/verde_campo"
            android:text="@string/etiqueta_clima" />

        <CheckBox
            android:id="@+id/check_soleado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clima_soleado" />

        <CheckBox
            android:id="@+id/check_lluvia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clima_lluvia" />

        <CheckBox
            android:id="@+id/check_nieve"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/clima_nieve" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="@color/verde_campo"
            android:text="@string/etiqueta_cuarto" />

        <RadioGroup
            android:id="@+id/grupo_cuartos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_cuarto_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/cuarto_1" />

            <RadioButton
                android:id="@+id/radio_cuarto_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cuarto_2" />

            <RadioButton
                android:id="@+id/radio_cuarto_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cuarto_3" />

            <RadioButton
                android:id="@+id/radio_cuarto_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cuarto_4" />

        </RadioGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_transmision"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/etiqueta_transmision" />

        <TextView
            android:id="@+id/texto_linea_yardaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="@color/verde_campo"
            android:text="@string/etiqueta_linea_yardaje" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_linea_yardaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1"
            android:value="50" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="@color/verde_campo"
            android:text="@string/etiqueta_dia_partido" />

        <TextView
            android:id="@+id/texto_dia_partido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/etiqueta_dia_partido" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_elegir_fecha"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/boton_elegir_fecha" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_aplicar_ajustes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/azul_marino_equipo"
            android:text="@string/boton_aplicar_ajustes" />

    </LinearLayout>

</ScrollView>
